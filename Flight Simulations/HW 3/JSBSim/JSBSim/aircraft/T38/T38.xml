    <flight_control name="FCS: T38-FCS">

        <channel name="Pitch">
            <summer name="Pilot Pitch Sum">
                <input>fcs/elevator-cmd-norm</input>
                <input>fcs/pitch-trim-cmd-norm</input>
                <clipto>
                    <min>-1</min>
                    <max>1</max>
                </clipto>
            </summer>
            <scheduled_gain name="Pilot Pitch Feel">
                <input>fcs/pilot-pitch-sum</input>
                <table>
                  <independentVar>velocities/mach</independentVar>
                    <tableData>
                        0.0000	0.30
                        0.6000	0.30
                        1.2000	0.20
                    </tableData>
                </table>
            </scheduled_gain>
            <scheduled_gain name="Pitch Rate Feedback">
                <input>velocities/q-aero-rad_sec</input>
                <table>
                  <independentVar>aero/qbar-psf</independentVar>
                    <tableData>
                        0.0    0.547954148509
                        200.0  0.368600461228
                        400.0  0.237010581113
                        600.0  0.153241737744
                        800.0  0.107690807658
                        1000.0  0.0908118969698
                        1200.0  0.0898504400319
                        1400.0  0.088888983094
                        1600.0  0.0879160802401
                        1800.0  0.0901404032354
                        2000.0  0.0924219558103
                    </tableData>
                </table>
                <!-- set gain to 0.0 to disable pitch SAS -->
                <gain>1.0</gain>
            </scheduled_gain>
            <washout_filter name="Pitch Rate Washout">
                <input>fcs/pitch-rate-feedback</input>
                <c1>2.0</c1>
            </washout_filter>
            <summer name="Pitch Feedback Sum">
                <input>fcs/pilot-pitch-feel</input>
                <input>fcs/pitch-rate-washout</input>
            </summer>
            <aerosurface_scale name="Elevator Control">
                <input>fcs/pitch-feedback-sum</input>
                <range>
                    <min>-1.0</min>
                    <max> 1.0</max>
                </range>
                <clipto>
                    <min>-0.30</min>
                    <max>0.14</max>
                </clipto>
                <output>fcs/elevator-pos-rad</output>
            </aerosurface_scale>
        </channel>

        <channel name="Roll">
            <summer name="Pilot Roll Sum">
                <input>fcs/aileron-cmd-norm</input>
                <input>fcs/roll-trim-cmd-norm</input>
                <clipto>
                    <min>-1</min>
                    <max>1</max>
                </clipto>
            </summer>
            <scheduled_gain name="Pilot Roll Feel">
                <input>fcs/pilot-roll-sum</input>
                <table>
                  <independentVar>velocities/mach</independentVar>
                    <tableData>
                        0.0000	0.30
                        0.6000	0.30
                        1.2000	0.20
                    </tableData>
                </table>
            </scheduled_gain>
            <aerosurface_scale name="Left Aileron Control">
                <input>-fcs/pilot-roll-feel</input>
                <range>
                    <min>-1.0</min>
                    <max> 1.0</max>
                </range>
                <clipto>
                    <min>-0.24</min>
                    <max>0.32</max>
                </clipto>
                <output>fcs/left-aileron-pos-rad</output>
            </aerosurface_scale>
            <aerosurface_scale name="Right Aileron Control">
                <input>fcs/pilot-roll-feel</input>
                <range>
                    <min>-1.0</min>
                    <max> 1.0</max>
                </range>
                <clipto>
                    <min>-0.24</min>
                    <max>0.32</max>
                </clipto>
              <output>fcs/right-aileron-pos-rad</output>
           </aerosurface_scale>
        </channel>

        <channel name="Yaw">
            <summer name="Pilot Yaw Sum">
                <input>fcs/rudder-cmd-norm</input>
                <input>fcs/yaw-trim-cmd-norm</input>
                <clipto>
                    <min>-1</min>
                    <max>1</max>
                </clipto>
            </summer>
            <scheduled_gain name="Pilot Yaw Feel">
                <input>fcs/pilot-yaw-sum</input>
                <table>
                  <independentVar>velocities/mach</independentVar>
                    <tableData>
                        0.0000	0.10
                        0.6000	0.10
                        1.2000	0.05
                    </tableData>
                </table>
            </scheduled_gain>
            <scheduled_gain name="Yaw Rate Feedback">
                <input>velocities/r-aero-rad_sec</input>
                <table>
                  <independentVar>aero/qbar-psf</independentVar>
                    <tableData>
                        0.0  1.78407110033
                        200.0  1.22877248911
                        400.0  0.8773637936
                        600.0  0.675732538619
                        800.0  0.544142658505
                        1000.0  0.482674274668
                        1200.0  0.472144032015
                        1400.0  0.471182575077
                        1600.0  0.476581232089
                        1800.0  0.475642666983
                        2000.0  0.477878435894
                    </tableData>
                </table>
                <!-- set gain to 0.0 to disable yaw SAS -->
                <gain>1.0</gain>
            </scheduled_gain>
            <washout_filter name="Yaw Rate Washout">
                <input>fcs/yaw-rate-feedback</input>
                <c1>1.0</c1>
            </washout_filter>
            <summer name="Yaw Feedback Sum">
                <input>fcs/pilot-yaw-feel</input>
                <input>fcs/yaw-rate-washout</input>
            </summer>
            <pure_gain name="Aileron Rudder Gain">
                <input>fcs/pilot-roll-feel</input>
                <!-- set gain to 0.0 to disable aileron interconnect -->
                <gain>0.23</gain>
            </pure_gain>
            <switch name="Aileron Rudder Switch">
                <default value="0"/>
                <test value="fcs/aileron-rudder-gain">
                    aero/qbar-psf GT 600.0
                </test>
            </switch>
            <summer name="Yaw Interconnect Sum">
                <input>fcs/yaw-feedback-sum</input>
                <input>fcs/aileron-rudder-switch</input>
            </summer>
            <aerosurface_scale name="Rudder Control">
                <input>fcs/yaw-interconnect-sum</input>
                <range>
                    <min>-1.0</min>
                    <max> 1.0</max>
                </range>
                <clipto>
                    <min>-0.10</min>
                    <max>0.10</max>
                </clipto>
                <output>fcs/rudder-pos-rad</output>
            </aerosurface_scale>
        </channel>

        <channel name="Throttles">
         <pure_gain name="Throttle1">
            <input>fcs/throttle-cmd-norm</input>
            <gain>2</gain>
            <output>fcs/throttle-pos-norm</output>
         </pure_gain>

         <pure_gain name="Throttle2">
            <input>fcs/throttle-cmd-norm[1]</input>
            <gain>2</gain>
            <output>fcs/throttle-pos-norm[1]</output>
         </pure_gain>
        </channel>

        <channel name="Flaps">
            <kinematic name="Flaps Control">
                <input>fcs/flap-cmd-norm</input>
                <traverse>
                    <setting>
                        <position>0</position>
                        <time>0</time>
                    </setting>
                    <setting>
                        <position>20</position>
                        <time>5</time>
                    </setting>
                    <setting>
                        <position>40</position>
                        <time>3</time>
                    </setting>
                </traverse>
                <output>fcs/flap-pos-deg</output>
            </kinematic>
            <aerosurface_scale name="Flap Position Normalizer">
              <input>fcs/flap-pos-deg</input>
              <domain>
                <min>0</min>  <!-- Flaps actual minimum position -->
                <max>40</max>  <!-- Flaps actual maximum position -->
              </domain>
              <range>
                <min>0</min>  <!-- Flaps normalized minimum position -->
                <max>1</max>  <!-- Flaps normalized maximum position -->
              </range>
              <output>fcs/flap-pos-norm</output>
            </aerosurface_scale>
        </channel>

        <channel name="Landing Gear">
            <kinematic name="Gear Control">
                <input>gear/gear-cmd-norm</input>
                <traverse>
                    <setting>
                        <position>0</position>
                        <time>0</time>
                    </setting>
                    <setting>
                        <position>1</position>
                        <time>3</time>
                    </setting>
                </traverse>
                <output>gear/gear-pos-norm</output>
            </kinematic>
        </channel>

        <channel name="Speedbrake">
            <kinematic name="Speedbrake Control">
                <input>fcs/speedbrake-cmd-norm</input>
                <traverse>
                    <setting>
                        <position>0</position>
                        <time>0</time>
                    </setting>
                    <setting>
                        <position>1</position>
                        <time>1</time>
                    </setting>
                </traverse>
                <output>fcs/speedbrake-pos-norm</output>
            </kinematic>
        </channel>
    </flight_control>

